<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7-11: DataStore preferences live under files/datastore, not shared_prefs.
     Explicit includes exclude other files/domains by default, including future
     diagnostic files and DataStore temporary/coordination files. -->
<full-backup-content>
    <!-- Layouts, per-widget settings, Demo layout, and introduction preferences. -->
    <include domain="file" path="datastore/dashboard_layouts.preferences_pb" />
    <include domain="file" path="datastore/appearance.preferences_pb" />
</full-backup-content>
